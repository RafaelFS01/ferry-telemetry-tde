# Configurações de Rede
aws_region                = "us-east-1"
environment               = "prod"
vpc_cidr                  = "10.0.0.0/16"
public_subnet_a_cidr      = "10.0.1.0/24"
public_subnet_b_cidr      = "10.0.2.0/24"
private_app_subnet_a_cidr = "10.0.10.0/24"
private_app_subnet_b_cidr = "10.0.20.0/24"
private_db_subnet_a_cidr  = "10.0.100.0/24"
private_db_subnet_b_cidr  = "10.0.200.0/24"
admin_cidr                = "0.0.0.0/0"

# Configurações de Banco de Dados RDS PostgreSQL 18
db_engine_version          = "18.6"
db_instance_class          = "db.t4g.micro"
db_name                    = "ferry_telemetry"
db_username                = "ferry_admin"
db_password                = "FerrySecure2026!"
db_allocated_storage       = 20
db_max_allocated_storage   = 50
db_backup_retention_period = 1

# Configurações de Mensageria SNS & SQS
sns_topic_name                 = "ferry-telemetria-topic"
sqs_db_writer_queue_name       = "ferry-db-writer-queue"
sqs_alerts_queue_name          = "ferry-alerts-queue"
sqs_dlq_name                   = "ferry-telemetry-dlq"
sqs_max_receive_count          = 5
sqs_visibility_timeout_seconds = 30
sqs_message_retention_seconds  = 345600
sqs_dlq_retention_seconds      = 1209600


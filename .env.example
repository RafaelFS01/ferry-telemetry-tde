# Copie para .env e ajuste se necessário. Valores apenas para desenvolvimento local.
POSTGRES_USER=ferry
POSTGRES_PASSWORD=ferry_local
POSTGRES_PORT=5432
TELEMETRY_DB=ferry_telemetry

AWS_REGION=us-east-1
LOCALSTACK_VERSION=4.9
# Necessário apenas se a versão escolhida do LocalStack exigir token
LOCALSTACK_AUTH_TOKEN=

BOAT_ID=ferry-ivete-sangalo

# SCRUM-14: deadline por RPC (1–2500ms) e tentativas totais (1–10).
GRPC_DEADLINE_MS=2500
GRPC_RETRY_MAX_ATTEMPTS=6
